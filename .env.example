# ================================================================
# COMPRE FÁCIL MAIS — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha todos os valores
# ================================================================

# Supabase — encontre em: supabase.com > seu projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Mercado Pago — encontre em: mercadopago.com.br > Suas integrações > Credenciais
# Use TEST-... para testes e APP_USR-... para produção
MERCADOPAGO_ACCESS_TOKEN=TEST-SEU_TOKEN_AQUI

# Mercado Pago Webhook Secret — encontre em: MP > Suas integrações > Webhooks > Chave secreta
# Necessário para validar a assinatura HMAC dos webhooks recebidos
MERCADOPAGO_WEBHOOK_SECRET=SUA_WEBHOOK_SECRET_AQUI

# WhatsApp Admin (DDI + DDD + número, sem espaços ou traços)
NEXT_PUBLIC_WHATS_ADMIN=5567900000000

# URL pública do app (sem barra no final)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seudominio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo para proteger os cron jobs (rotas /api/logistica/cron e /api/saques/cron)
# Pode ser qualquer texto aleatório seguro — use o mesmo valor no pg_cron do Supabase
CRON_SECRET=comprefacil_cron_2025
NEXT_PUBLIC_GOOGLE_TTS_KEY=AIzaSyCeFe3hzWLgiEBBiRWAx10ZdaST064K8SM
